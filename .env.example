# Optional overrides. Defaults work in Docker.
# HOST=127.0.0.1
# PORT=8790
# PL8_DB=/data/pl8list.db
# CACHE_DIR=/data/cache          # audio segments and images, default: next to the DB
# CACHE_MAX_MB=2048
# Set by compose.override.yaml when behind Traefik:
# TRUSTED_PROXY_HOPS=1           # proxies that append to X-Forwarded-For (TRUST_PROXY=1 also means 1)
# PUBLIC_ORIGIN=https://pl8.narl.io
# Only for plain-http development from another machine (drops Secure, __Host-, HSTS):
# INSECURE_COOKIES=1

# Impressum and privacy policy. Required for a public site in Germany.
# Separate address lines with "|".
IMPRESSUM_NAME=
IMPRESSUM_ADDRESS=
IMPRESSUM_EMAIL=
IMPRESSUM_PHONE=
HOSTING_PROVIDER=
